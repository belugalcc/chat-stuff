{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lcc-chat",
	"main": "./src/index.js",
	"compatibility_date": "2026-07-28",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/ws/*",
			"/ice"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "LCC_CHAT",
				"class_name": "LccChat"
			},
			{
				"name": "CENTRAL_CALL",
				"class_name": "CentralCall"
			}
		]
	},
	"exports": {
		"LccChat": {
			"type": "durable-object",
			"storage": "sqlite"
		},
		"CentralCall": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
